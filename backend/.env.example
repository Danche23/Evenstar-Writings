# 应用配置
APP_NAME=evenstar-api
APP_VERSION=1.0.0
APP_MODE=debug
APP_PORT=8080

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=evenstar

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT 配置
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# 日志配置
LOG_LEVEL=debug
LOG_FILENAME=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true

# 阿里云邮件推送
MAIL_PASSWORD=

# 阿里云 OSS
OSS_ACCESS_KEY_SECRET=

# 阿里云验证码 2.0
CAPTCHA_ACCESS_KEY_SECRET=

# 管理员初始化（首次启动时若无管理员则按此创建；不设置则生成随机密码打印到日志）
EVENSTAR_ADMIN_USERNAME=
EVENSTAR_ADMIN_EMAIL=
EVENSTAR_ADMIN_PASSWORD=
