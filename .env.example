# ===== Evenstar Writings 部署密钥模板 =====
# 用法：在服务器上复制为 .env，填入真实值，然后 chmod 600 .env
#
# 键名必须与 backend/pkg/config/loader.go 的 os.Getenv 完全一致
# （这些变量名不带 EVENSTAR_ 前缀，除了最后的管理员三项）
#
# ⚠️ .env 含全部密钥，绝不能提交到 git

# ---------- compose 自用 ----------
MYSQL_ROOT_PASSWORD=换成你自己的强密码
MYSQL_DATABASE=evenstar
REDIS_PASSWORD=换成你自己的强密码

# ---------- 后端：数据库 ----------
# host 用 compose 服务名，不是 localhost
MYSQL_HOST=mysql
MYSQL_PASSWORD=与 MYSQL_ROOT_PASSWORD 保持一致
REDIS_HOST=redis
REDIS_PASSWORD=与上面的 REDIS_PASSWORD 保持一致
JWT_SECRET=换成一串足够长的随机字符

# ---------- 后端：运行环境 ----------
APP_MODE=release
LOG_LEVEL=info
# 填前端站点地址（跨域白名单）。本地开发填 http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------- 后端：邮件（阿里云 DirectMail）----------
# 若邮件暂时不可用，把 MAIL_MOCK 改成 true 可避免后端启动失败
MAIL_MOCK=false
MAIL_HOST=smtpdm.aliyun.com
MAIL_USERNAME=no-reply@your-domain.com
MAIL_FROM_ADDR=no-reply@your-domain.com
MAIL_PASSWORD=邮件推送的 SMTP 密码

# ---------- 后端：阿里云 OSS（图片存储）----------
OSS_ACCESS_KEY_ID=RAM 用户的 AccessKey ID
OSS_ACCESS_KEY_SECRET=RAM 用户的 AccessKey Secret

# ---------- 后端：阿里云 Captcha 2.0（滑块验证）----------
CAPTCHA_ACCESS_KEY_ID=RAM 用户的 AccessKey ID
CAPTCHA_ACCESS_KEY_SECRET=RAM 用户的 AccessKey Secret
CAPTCHA_SCENE_ID=在阿里云验证码控制台创建场景后获得

# ---------- 后端：管理员引导 ----------
# 仅当 users 表里没有 role=1 的管理员时才生效。
# 因为本次要迁移已有数据（库里已有管理员），这三项通常不会触发。
EVENSTAR_ADMIN_USERNAME=admin
EVENSTAR_ADMIN_EMAIL=你的邮箱
EVENSTAR_ADMIN_PASSWORD=你想要的密码
